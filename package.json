{
  "name": "greencrownkms",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build --configLoader runner",
    "build:electron": "vite build --configLoader runner --base=./",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "electron:dev": "node electron/dev.mjs",
    "electron:build": "vite build --configLoader runner --base=./ && cross-env ELECTRON_BUILDER_CACHE=.electron-builder-cache electron-builder",
    "build:win": "vite build --configLoader runner --base=./ && cross-env ELECTRON_BUILDER_CACHE=.electron-builder-cache electron-builder --win",
    "build:aok": "vite build --config vite.aok.config.js",
    "cap:init": "npx cap init",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:android": "npx cap open android",
    "cap:build:android": "npm run build && npx cap sync && npx cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/cli": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@heroicons/react": "^2.2.0",
    "@supabase/supabase-js": "^2.105.3",
    "@tanstack/react-query": "^5.100.9",
    "@zxing/library": "^0.23.0",
    "date-fns": "^4.1.0",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.38.0",
    "html2canvas": "^1.4.1",
    "i18next": "^26.3.0",
    "jspdf": "^4.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.15.0",
    "recharts": "^3.8.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.11",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "cross-env": "^10.1.0",
    "electron": "^35.3.0",
    "electron-builder": "^26.0.12",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jimp": "^1.6.1",
    "jsdom": "^26.1.0",
    "odbc": "^2.4.8",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.19",
    "tailwindcss-rtl": "^0.9.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.1.3",
    "wait-on": "^8.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
